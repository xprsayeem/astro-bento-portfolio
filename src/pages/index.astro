  ---
  import Layout from "../layouts/Layout.astro";
  import Card from "../components/Card/index.astro";
  import IntroCard from "../components/IntroCard.astro";
  import ProjectsCard from "../components/ProjectsCard.astro";
  import TimeZone from "../components/TimeZoneCard.astro";
  import AboutMe from "../components/AboutMe.astro";
  import Now from "../components/Now.astro";
  import Globe from "../components/Globe";
  ---

  <script>
    import { stagger, animate, type AnimationSequence } from "motion";
    import { loaderAnimation } from "../lib/constants";
    const cards = document.querySelectorAll(".card");

    const sequence = [
      loaderAnimation,
      [
        cards,
        { y: ["40%", "0%"], opacity: [0, 1] },
        {
          type: "spring",
          at: "-0.1",
          delay: stagger(0.3),
        },
      ],
    ];

    // The cards' entrance animation starts them translated down (y:40%), which
    // briefly extends the page past the viewport and flashes a scrollbar. Hide
    // the vertical scrollbar until the animation settles, then restore it so
    // short screens can still scroll.
    const root = document.documentElement;
    root.style.overflowY = "hidden";
    const restore = () => { root.style.overflowY = ""; };
    const controls = animate(sequence as AnimationSequence);
    controls?.finished?.then(restore).catch(restore);
    setTimeout(restore, 3200); // safety net if `finished` never resolves
  </script>
  <Layout
    description="Hi, I’m Sayeem Mahfuz, a CS senior shaping data systems that scale. My work bridges analytics and engineering, focusing on building reliable, cloud-based pipelines on AWS and Databricks that turn raw data into clear, actionable insight."
    title="Sayeem Mahfuz :P"
  >
    <main
      class="text-white m-auto p-2 grid gap-2 max-w-6xl relative w-full overflow-x-hidden sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:min-h-screen lg:grid-rows-[repeat(7,minmax(min-content,1fr))] lg:grid-cols-4 lg:gap-4 lg:py-4"
    >
      <IntroCard />
      <AboutMe />
      <ProjectsCard />
      <Card
        title="Time zone"
        colSpan="md:col-span-2"
        rowSpan="md:row-span-2"
      >
        <TimeZone label="Toronto" />
      </Card>

      <Now />
      <Card
        colorText="text-neutral-900"
        colSpan="md:col-span-1"
        href="travel"
        rowSpan="md:row-span-2"
        title="Countries I've visited"
      >
        <div class="h-full w-full absolute inset-0 -z-10">
          <Globe client:load scale={280} />
        </div>
      </Card>
    </main>
  </Layout>
