---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";

const LIVE = "https://prof-pulse-red.vercel.app";
const CODE = "https://github.com/xprsayeem/Prof-Pulse";
---

<!-- Motion animation -->
<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../lib/constants";

  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      { type: "spring", at: "-0.1", delay: stagger(0.3) },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<Layout
  title="Prof Pulse"
  description="TMU course and professor insights built from 108,000+ student reviews."
  showLoader>

  <main class="text-white m-auto p-2 max-w-6xl overflow-visible relative w-full sm:p-4 md:p-6 lg:p-8 space-y-8">
    <!-- Top nav: Back -->
    <nav class="w-full sticky top-0 z-40 mb-3">
      <div class="flex gap-2">
        <button
          type="button"
          onclick="history.back()"
          class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 text-sm hover:bg-white/10 active:scale-[0.99] transition"
          aria-label="Go back"
        >
          ← Back
        </button>
      </div>
    </nav>

    <section class="!h-auto !overflow-visible space-y-6">

      <!-- ============ HERO ============ -->
      <Card title="Prof Pulse" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-6">
          <div>
            <p class="text-lg font-medium text-neutral-100">Make every course count.</p>
            <p class="text-sm text-neutral-300 leading-relaxed mt-2">
              Prof Pulse is a course-and-professor discovery site for Toronto Metropolitan University. It turns
              <strong class="text-white">108,000+ student reviews</strong> into something students can actually act on:
              search any course or professor, see how hard a class really is, which professor gets the best results in it,
              and what grades people walk away with, all in one place.
            </p>
          </div>

          <!-- Headline stat tiles -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-blue-400">108K+</div>
              <div class="text-[11px] text-neutral-400">Reviews analyzed</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-purple-400">7,099</div>
              <div class="text-[11px] text-neutral-400">Courses</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-teal-400">3,465</div>
              <div class="text-[11px] text-neutral-400">Professors</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-amber-400">~1s</div>
              <div class="text-[11px] text-neutral-400">Page load</div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="flex flex-wrap items-center gap-2">
            <a href={LIVE} target="_blank" rel="noreferrer"
               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-md transition-colors text-sm font-medium text-white">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              View live site
            </a>
            <a href={CODE} target="_blank" rel="noreferrer"
               class="inline-flex items-center gap-2 px-4 py-2 bg-neutral-800 hover:bg-neutral-700 rounded-md transition-colors text-sm font-medium text-neutral-200">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
              </svg>
              View code on GitHub
            </a>
          </div>
        </div>
      </Card>

      <!-- ============ THE PROBLEM ============ -->
      <Card title="The problem: students pick courses, not just professors" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <p class="text-sm text-neutral-300 leading-relaxed">
            Every student knows RateMyProfessors. But it only answers half the question. It rates the
            <strong class="text-white">professor</strong> — not the <strong class="text-white">course</strong>. A 5-star
            professor can still be teaching a brutal, low-average class, and an "easy" course can be miserable with the
            wrong instructor. When you're building a timetable, you're choosing a <em>course-and-professor pairing</em>,
            and RateMyProfessors can't show you that.
          </p>

          <!-- Side-by-side comparison -->
          <div class="grid gap-3 md:grid-cols-2">
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-lg">📗</span>
                <h4 class="font-semibold text-neutral-200 text-sm">RateMyProfessors</h4>
              </div>
              <ul class="text-xs text-neutral-400 space-y-1.5">
                <li class="flex gap-2"><span class="text-neutral-600">•</span> Rates professors only</li>
                <li class="flex gap-2"><span class="text-neutral-600">•</span> No course-level difficulty or grades</li>
                <li class="flex gap-2"><span class="text-neutral-600">•</span> Can't tell you the best prof <em>for a specific course</em></li>
                <li class="flex gap-2"><span class="text-neutral-600">•</span> No easy-elective discovery</li>
              </ul>
            </div>
            <div class="rounded-xl bg-gradient-to-br from-blue-950/40 to-purple-950/30 border border-blue-500/30 p-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-lg">📊</span>
                <h4 class="font-semibold text-blue-200 text-sm">Prof Pulse</h4>
              </div>
              <ul class="text-xs text-neutral-300 space-y-1.5">
                <li class="flex gap-2"><span class="text-blue-400">✓</span> Professors <strong class="text-white">and</strong> courses, side by side</li>
                <li class="flex gap-2"><span class="text-blue-400">✓</span> Grade distributions + difficulty trends over time</li>
                <li class="flex gap-2"><span class="text-blue-400">✓</span> Ranks which professor is best <em>for that course</em></li>
                <li class="flex gap-2"><span class="text-blue-400">✓</span> "Bird courses" (easy A's) + liberal-elective browser</li>
              </ul>
            </div>
          </div>

          <p class="text-sm text-neutral-300 leading-relaxed">
            The result: instead of guessing, a student can answer the real question —
            <strong class="text-blue-300">"Which course, with which professor, gives me the best experience and outcome?"</strong>
          </p>

          <!-- What you can do -->
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 mt-1">
            <div class="rounded-lg bg-white/5 border border-white/10 p-3">
              <div class="text-xl mb-1">🔎</div>
              <h5 class="text-xs font-semibold text-neutral-100">Search anything</h5>
              <p class="text-[11px] text-neutral-400 leading-tight">By course code, subject, or professor name.</p>
            </div>
            <div class="rounded-lg bg-white/5 border border-white/10 p-3">
              <div class="text-xl mb-1">🐦</div>
              <h5 class="text-xs font-semibold text-neutral-100">Find bird courses</h5>
              <p class="text-[11px] text-neutral-400 leading-tight">Easiest A's, ranked by real grade data.</p>
            </div>
            <div class="rounded-lg bg-white/5 border border-white/10 p-3">
              <div class="text-xl mb-1">📚</div>
              <h5 class="text-xs font-semibold text-neutral-100">Browse electives</h5>
              <p class="text-[11px] text-neutral-400 leading-tight">Every liberal-studies option with ratings.</p>
            </div>
            <div class="rounded-lg bg-white/5 border border-white/10 p-3">
              <div class="text-xl mb-1">⚖️</div>
              <h5 class="text-xs font-semibold text-neutral-100">Compare</h5>
              <p class="text-[11px] text-neutral-400 leading-tight">Courses or professors, head to head.</p>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ HOW IT'S BUILT: PIPELINE ============ -->
      <Card title="How it's built: from raw reviews to a fast website" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-5">
          <p class="text-sm text-neutral-300 leading-relaxed">
            Behind the scenes, a <strong class="text-white">data pipeline</strong> runs on a schedule. Think of it as an
            assembly line: raw, messy review data goes in one end, and clean, ready-to-use files come out the other,
            which the website reads directly. There's no database server to maintain, the site is just fast static files
            that refresh themselves.
          </p>

          <!-- Pipeline flow diagram -->
          <div class="rounded-xl bg-black/20 border border-white/10 p-4 sm:p-5">
            <div class="flex flex-col items-stretch gap-2">

              <!-- Source -->
              <div class="rounded-lg bg-white/5 border border-white/10 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">📡</span>
                <div>
                  <div class="text-sm font-semibold text-neutral-100">RateMyProfessors</div>
                  <div class="text-[11px] text-neutral-400">The raw source of student reviews</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Ingest -->
              <div class="rounded-lg bg-white/5 border border-white/10 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">🐍</span>
                <div>
                  <div class="text-sm font-semibold text-neutral-100">Daily scrape <span class="text-[11px] font-normal text-neutral-400">(Python)</span></div>
                  <div class="text-[11px] text-neutral-400">Pulls the latest reviews into cloud storage</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Medallion -->
              <div class="text-[11px] uppercase tracking-wider text-neutral-500 text-center mt-1">Cleaned in stages on Databricks (PySpark)</div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-stretch">
                <div class="rounded-lg bg-amber-950/30 border border-amber-500/30 px-3 py-3">
                  <div class="flex items-center gap-2"><span>🥉</span><span class="text-sm font-semibold text-amber-200">Bronze</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">Raw, validated snapshots. Nothing thrown away.</div>
                </div>
                <div class="rounded-lg bg-slate-700/30 border border-slate-400/30 px-3 py-3">
                  <div class="flex items-center gap-2"><span>🥈</span><span class="text-sm font-semibold text-slate-200">Silver</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">Cleaned + standardized (fixing messy grades, codes).</div>
                </div>
                <div class="rounded-lg bg-yellow-900/30 border border-yellow-500/30 px-3 py-3">
                  <div class="flex items-center gap-2"><span>🥇</span><span class="text-sm font-semibold text-yellow-200">Gold</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">Ready-to-use metrics: ratings, grades, rankings, trends.</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Export -->
              <div class="rounded-lg bg-blue-950/30 border border-blue-500/30 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">☁️</span>
                <div>
                  <div class="text-sm font-semibold text-blue-200">Export to AWS S3</div>
                  <div class="text-[11px] text-neutral-400">~25,000 small JSON files, one per course and professor</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Serve -->
              <div class="rounded-lg bg-purple-950/30 border border-purple-500/30 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">⚡</span>
                <div>
                  <div class="text-sm font-semibold text-purple-200">Next.js website</div>
                  <div class="text-[11px] text-neutral-400">Reads only the files a page needs, caches them, refreshes daily</div>
                </div>
              </div>

            </div>
          </div>

          <p class="text-[11px] text-neutral-400 leading-relaxed">
            This "medallion" pattern (bronze → silver → gold) keeps a clean audit trail: every number on the site can be
            traced back through the layers to the original review it came from.
          </p>
        </div>
      </Card>

      <!-- ============ THE ENGINEERING CHALLENGE ============ -->
      <Card title="The hard problem: a 76 MB download on every page" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <p class="text-sm text-neutral-300 leading-relaxed">
            The first version worked, until it didn't. Because the site read files straight from storage, every professor
            page downloaded the <strong class="text-white">entire 76 MB reviews file</strong> and sifted through it for one
            person. On a good connection it took 20–35 seconds and the download <strong class="text-red-300">failed
            about half the time</strong> mid-transfer. Not good enough.
          </p>

          <!-- Before / After -->
          <div class="grid gap-3 md:grid-cols-[1fr_auto_1fr] items-center">
            <div class="rounded-xl bg-red-950/20 border border-red-500/30 p-4">
              <div class="text-[11px] uppercase tracking-wider text-red-300/80 mb-2">Before</div>
              <ul class="space-y-2 text-sm">
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Data / page</span><span class="font-bold text-red-300">~63 MB</span></li>
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Load time</span><span class="font-bold text-red-300">20–35 s</span></li>
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Reliability</span><span class="font-bold text-red-300">~50% fail</span></li>
              </ul>
            </div>
            <div class="text-center text-neutral-500">
              <div class="text-2xl">→</div>
              <div class="text-[10px] uppercase tracking-wider">sharding</div>
            </div>
            <div class="rounded-xl bg-green-950/20 border border-green-500/30 p-4">
              <div class="text-[11px] uppercase tracking-wider text-green-300/80 mb-2">After</div>
              <ul class="space-y-2 text-sm">
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Data / page</span><span class="font-bold text-green-300">~500 KB</span></li>
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Load time</span><span class="font-bold text-green-300">~1 s</span></li>
                <li class="flex items-baseline justify-between"><span class="text-neutral-400 text-xs">Reliability</span><span class="font-bold text-green-300">rock solid</span></li>
              </ul>
            </div>
          </div>

          <p class="text-sm text-neutral-300 leading-relaxed">
            The fix was <strong class="text-white">sharding</strong>: instead of a few giant files, the pipeline now writes
            one tiny file per course and per professor. A page grabs only the few kilobytes it actually shows, a
            <strong class="text-green-300">~99% cut</strong> in data per page. Same information, delivered surgically
            instead of by the truckload.
          </p>
        </div>
      </Card>

      <!-- ============ MORE PROBLEMS SOLVED ============ -->
      <Card title="Other problems solved along the way" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-3 md:grid-cols-3">

          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🧹</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Messy real-world data</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Grades came in as <code class="bg-neutral-800 px-1 rounded text-[10px]">"Not sure yet"</code> and
              <code class="bg-neutral-800 px-1 rounded text-[10px]">"Not_Sure_Yet"</code>; course codes had dozens of
              prefixes. The silver layer standardizes it all so the charts and rankings are actually trustworthy.
            </p>
          </div>

          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🔐</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Writing 25,000 files, securely</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              The locked-down Databricks cluster blocks the usual cloud credentials. I stored a dedicated key in a
              <strong class="text-neutral-200">Databricks secret scope</strong> and wrote all the shards to S3 in parallel,
              turning a ~90-minute job into a few minutes.
            </p>
          </div>

          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🎨</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">A cohesive redesign</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              The UI was rebuilt on a <strong class="text-neutral-200">design-token system</strong>: a warm
              "charcoal + ochre" theme with editorial headings. One change re-skins every page, so the look can't drift
              as the site grows.
            </p>
          </div>

        </div>
      </Card>

      <!-- ============ TECH STACK ============ -->
      <Card title="The stack" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-3 md:grid-cols-3">
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-amber-300 mb-2 uppercase tracking-wider">Data pipeline</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Databricks</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">PySpark</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Delta Lake</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Python</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">AWS S3</span>
            </div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-blue-300 mb-2 uppercase tracking-wider">Frontend</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Next.js</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">React</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">TypeScript</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Tailwind CSS</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">shadcn/ui</span>
            </div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-purple-300 mb-2 uppercase tracking-wider">Delivery</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Vercel</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">ISR caching</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">GitHub</span>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ LIVE PREVIEW ============ -->
      <Card rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <section class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <h3 class="font-semibold text-neutral-200">See it live</h3>
            <a href={LIVE} target="_blank" rel="noreferrer" class="text-xs underline text-neutral-400 hover:text-white">Open in new tab ↗</a>
          </div>
          <p class="text-xs text-neutral-400">
            The real site, embedded below, search a course or professor to explore ratings, grade distributions, and comparisons.
          </p>
          <iframe
            src={LIVE}
            class="w-full h-[32rem] rounded-lg border border-white/10 bg-white"
            loading="lazy"
            title="Prof Pulse live site"
          ></iframe>
        </section>
      </Card>

    </section>
  </main>
</Layout>
