---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card/index.astro";
---

<!-- Motion animation -->
<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../lib/constants";

  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      { type: "spring", at: "-0.1", delay: stagger(0.3) },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<Layout
  title="Minds-On — Data Platform & Digital Growth Engine"
  description="A full data platform and digital growth engine for a Whitby youth organization: a relational Airtable architecture unified into BigQuery, wired to GA4/GTM, offline conversion tracking, SEO, paid media, and live Looker Studio dashboards."
  showLoader>

  <main class="text-white m-auto p-2 max-w-6xl overflow-visible relative w-full sm:p-4 md:p-6 lg:p-8 space-y-8">
    <!-- Top nav: Back -->
    <nav class="w-full sticky top-0 z-40 mb-3">
      <div class="flex gap-2">
        <button
          type="button"
          onclick="window.location.href='/'"
          class="px-3 py-1.5 rounded-lg border border-white/10 bg-white/5 text-sm hover:bg-white/10 active:scale-[0.99] transition"
          aria-label="Go back"
        >
          ← Back
        </button>
      </div>
    </nav>

    <section class="!h-auto !overflow-visible space-y-6">

      <!-- ============ HERO ============ -->
      <Card title="Minds-On — Data Platform & Digital Growth Engine" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-6">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-sky-500/15 border border-sky-500/30 text-sky-200 text-[11px] px-2.5 py-0.5">Aug 2025 – Present</span>
              <span class="rounded-full bg-white/5 border border-white/10 text-neutral-300 text-[11px] px-2.5 py-0.5">Whitby, ON youth organization</span>
            </div>
            <p class="text-lg font-medium text-neutral-100 mt-1">One source of truth, and a growth engine on top of it.</p>
            <p class="text-sm text-neutral-300 leading-relaxed">
              I lead the data and growth infrastructure for a Whitby-based youth organization serving
              <strong class="text-white">1,000+ students across 20+ programs</strong>. The work spans two halves that feed each
              other: a <strong class="text-white">relational data platform</strong> that replaced disconnected spreadsheets with
              validated, connected data unified in <strong class="text-white">BigQuery</strong>, and a
              <strong class="text-white">digital growth engine</strong> — GA4/GTM tracking, offline conversion feedback, SEO, paid
              media, and live dashboards — that turns that clean data into enrollments. I act as the point of contact for
              leadership across the whole program.
            </p>
          </div>

          <!-- Headline stat tiles -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-sky-300">1,000+</div>
              <div class="text-[11px] text-neutral-400">students across 20+ programs</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-sky-300">100+</div>
              <div class="text-[11px] text-neutral-400">weekly registrations synced</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-sky-300">70%</div>
              <div class="text-[11px] text-neutral-400">less manual data processing</div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-3 text-center">
              <div class="text-2xl font-bold text-sky-300">30%</div>
              <div class="text-[11px] text-neutral-400">fewer data errors</div>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ THE ENGAGEMENT ============ -->
      <Card title="The engagement" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <p class="text-sm text-neutral-300 leading-relaxed">
            I started by running <strong class="text-white">requirements gathering with 10+ staff</strong> — stakeholder
            interviews and process mapping — to map how data, enrollment, and marketing actually flowed through the
            organization, and where it broke. That surfaced two connected problems: operational data was scattered across
            disconnected spreadsheets, and marketing had no reliable line of sight into what was actually driving enrollment.
            The build addresses both as one system.
          </p>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="text-2xl mb-2">🗄️</div>
              <h4 class="text-sm font-semibold text-neutral-100 mb-1">The data platform</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed">
                A relational Airtable architecture with automated intake, validation, and Python ETL — migrated into
                BigQuery as a central warehouse and modeled into clean layers.
              </p>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="text-2xl mb-2">📈</div>
              <h4 class="text-sm font-semibold text-neutral-100 mb-1">The growth engine</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed">
                GA4/GTM tracking, offline conversion feedback, SEO, and paid media across Google, Meta, and LinkedIn —
                all reporting back through the same warehouse.
              </p>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ SYSTEM OVERVIEW (replaces old architecture diagram) ============ -->
      <Card title="How it fits together" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-5">
          <p class="text-sm text-neutral-300 leading-relaxed">
            Operational, marketing, and CRM data land in <strong class="text-white">BigQuery</strong> as a single source of
            truth. Validated enrollments don't just sit there — they flow back out to the ad platforms as offline
            conversions, so acquisition spend is optimized against <strong class="text-white">real</strong> enrollments, not
            just form fills.
          </p>

          <!-- Full-system flow diagram -->
          <div class="rounded-xl bg-black/20 border border-white/10 p-4 sm:p-5">
            <div class="flex flex-col items-stretch gap-2">

              <!-- Sources -->
              <div class="text-[11px] uppercase tracking-wider text-neutral-500 text-center">Sources</div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-stretch">
                <div class="rounded-lg bg-white/5 border border-white/10 px-3 py-3">
                  <div class="flex items-center gap-2"><span>📝</span><span class="text-sm font-semibold text-neutral-100">Intake forms</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">Registrations & landing-page leads</div>
                </div>
                <div class="rounded-lg bg-white/5 border border-white/10 px-3 py-3">
                  <div class="flex items-center gap-2"><span>📣</span><span class="text-sm font-semibold text-neutral-100">Marketing</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">GA4, Google/Meta/LinkedIn Ads, Search Console</div>
                </div>
                <div class="rounded-lg bg-white/5 border border-white/10 px-3 py-3">
                  <div class="flex items-center gap-2"><span>🗂️</span><span class="text-sm font-semibold text-neutral-100">Airtable + CRM</span></div>
                  <div class="text-[11px] text-neutral-400 mt-1">Operational system of record</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Airtable layer -->
              <div class="rounded-lg bg-white/5 border border-white/10 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">⚙️</span>
                <div>
                  <div class="text-sm font-semibold text-neutral-100">Automation layer <span class="text-[11px] font-normal text-neutral-400">(JavaScript + Python ETL)</span></div>
                  <div class="text-[11px] text-neutral-400">Sync, validate & deduplicate on the way in; aggregate across bases</div>
                </div>
              </div>
              <div class="text-center text-neutral-600 text-lg leading-none">↓</div>

              <!-- Warehouse -->
              <div class="rounded-lg bg-sky-950/30 border border-sky-500/30 px-4 py-3 flex items-center gap-3">
                <span class="text-xl">🏛️</span>
                <div>
                  <div class="text-sm font-semibold text-sky-200">BigQuery warehouse</div>
                  <div class="text-[11px] text-neutral-400">Staging → reporting layers, joining operational + marketing + CRM into one source of truth</div>
                </div>
              </div>

              <!-- Two outputs -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 items-stretch mt-1">
                <div class="flex flex-col items-center gap-1">
                  <div class="text-neutral-600 text-lg leading-none">↓</div>
                  <div class="rounded-lg bg-sky-950/30 border border-sky-500/30 px-3 py-3 w-full">
                    <div class="flex items-center gap-2"><span>📊</span><span class="text-sm font-semibold text-sky-200">Looker Studio</span></div>
                    <div class="text-[11px] text-neutral-400 mt-1">Live dashboards + automated weekly leadership summaries</div>
                  </div>
                </div>
                <div class="flex flex-col items-center gap-1">
                  <div class="text-neutral-600 text-lg leading-none">↑</div>
                  <div class="rounded-lg bg-sky-950/30 border border-sky-500/30 px-3 py-3 w-full">
                    <div class="flex items-center gap-2"><span>🔁</span><span class="text-sm font-semibold text-sky-200">Offline conversions</span></div>
                    <div class="text-[11px] text-neutral-400 mt-1">Validated enrollments feed back to Google Ads & Meta for smarter bidding</div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </Card>

      <!-- ============ DATA ARCHITECTURE ============ -->
      <Card title="Relational data architecture" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <p class="text-sm text-neutral-300 leading-relaxed">
            The operational core is a <strong class="text-white">5-base relational architecture</strong> in Airtable, with
            ERD documentation, metadata definitions, and validation rules that keep data clean at the source.
            <strong class="text-white">Attendance</strong> is the junction table, linking students to both programs and events.
          </p>

          <ul class="list-disc list-inside text-neutral-300 space-y-1 pl-4 text-sm">
            <li><strong class="text-sky-300">Students</strong> — core records: personal info, school details, medical/dietary notes, guardian contacts</li>
            <li><strong class="text-sky-300">Attendance</strong> — junction table linking students to programs and events with check-in/out times</li>
            <li><strong class="text-sky-300">Programs</strong> — recurring activities with capacity, scheduling, and resource tracking</li>
            <li><strong class="text-sky-300">Staff</strong> — full-time, volunteers, and student leaders with certifications, availability, and assignments</li>
            <li><strong class="text-sky-300">Events</strong> — community events with budget, vendor, sponsor, and marketing sub-tables</li>
          </ul>

          <figure class="rounded-xl bg-white/5 border border-white/10 p-4 overflow-x-auto">
            <img
              src="/mindson-erd.png"
              alt="Minds-On Entity Relationship Diagram showing Students, Attendance, Programs, Staff, and Events bases with their relationships"
              class="w-full h-auto min-w-[600px]"
              loading="lazy"
            />
            <figcaption class="text-[11px] text-neutral-400 mt-2">
              The 5-base relational model. Attendance links students to both programs and events; staff assignments span both.
            </figcaption>
          </figure>
        </div>
      </Card>

      <!-- ============ AUTOMATION & ETL ============ -->
      <Card title="Automation & ETL" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-3 md:grid-cols-2">
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🔄</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Registration sync (JavaScript)</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              JavaScript automations sync <strong class="text-neutral-200">100+ weekly registrations</strong> from intake
              forms straight into the database, with validation and deduplication so bad or duplicate records never land.
            </p>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🐍</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Cross-base aggregation (Python)</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Python ETL scripts aggregate attendance and enrollment data <strong class="text-neutral-200">across
              bases</strong>, producing the joined tables that feed the warehouse and reporting layers.
            </p>
          </div>
        </div>
      </Card>

      <!-- ============ MEASUREMENT & GROWTH ============ -->
      <Card title="Measurement & conversion tracking" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <p class="text-sm text-neutral-300 leading-relaxed">
            I rebuilt tracking on <strong class="text-white">GA4 and Google Tag Manager</strong> with a clean event and
            conversion taxonomy, then closed the loop with offline conversion tracking so ad platforms optimize against
            outcomes that are actually real.
          </p>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <h4 class="text-sm font-semibold text-neutral-100 mb-2">Conversion taxonomy</h4>
              <div class="flex flex-wrap gap-1.5">
                <span class="rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-200 px-2 py-1 text-[11px]">Enrollment</span>
                <span class="rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-200 px-2 py-1 text-[11px]">Event RSVP</span>
                <span class="rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-200 px-2 py-1 text-[11px]">Sponsor inquiry</span>
                <span class="rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-200 px-2 py-1 text-[11px]">Donation</span>
              </div>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <h4 class="text-sm font-semibold text-neutral-100 mb-1">Offline conversion feedback</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed">
                Validated enrollments feed back into <strong class="text-neutral-200">Google Ads and Meta</strong>, so
                bidding is driven by confirmed enrollments — not raw form fills that may never convert.
              </p>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ ACQUISITION ============ -->
      <Card title="Acquisition: SEO, paid media & landing pages" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-3 md:grid-cols-3">
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🔍</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Technical & local SEO</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Site speed, structured data for programs and events, schema, Google Business Profile, and keyword mapping for
              <strong class="text-neutral-200">Durham Region intent</strong> — improving organic visibility for the searches
              that drive enrollment.
            </p>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🎯</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Paid media</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Google Ads (search + Performance Max), Meta, and LinkedIn, segmented by
              <strong class="text-neutral-200">program, enrollment season, and sponsor outreach</strong>. On-brand creative
              built with a designer and tested at the ad level.
            </p>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <div class="text-2xl mb-2">🧪</div>
            <h4 class="text-sm font-semibold text-neutral-100 mb-1">Landing pages</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Per-program and per-event landing pages, A/B tested, with form submissions wired into the existing validation
              layer — so marketing leads stay <strong class="text-neutral-200">clean</strong> end to end.
            </p>
          </div>
        </div>
      </Card>

      <!-- ============ REPORTING & DELIVERY ============ -->
      <Card title="Reporting, leadership & delivery" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="flex flex-col gap-4">
          <div class="space-y-2">
            <h4 class="text-sm font-semibold text-neutral-100">Live dashboards on BigQuery</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed">
              Looker Studio dashboards read directly from the warehouse, with automated weekly summaries emailed to leadership.
            </p>
            <div class="flex flex-wrap gap-1.5 mt-1">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Enrollment funnel</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Channel efficiency</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">SEO</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Event performance</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Sponsor pipeline</span>
            </div>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="text-2xl mb-2">🤝</div>
              <h4 class="text-sm font-semibold text-neutral-100 mb-1">Point of contact for leadership</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed">
                Performance reviews, next-step recommendations, and proactive flags on under-enrolling programs.
              </p>
            </div>
            <div class="rounded-xl bg-white/5 border border-white/10 p-4">
              <div class="text-2xl mb-2">🗂️</div>
              <h4 class="text-sm font-semibold text-neutral-100 mb-1">Program management in Asana</h4>
              <p class="text-[11px] text-neutral-400 leading-relaxed">
                A Gantt view across seasons, campaigns, content, and events — plus staff training for long-term adoption.
              </p>
            </div>
          </div>
        </div>
      </Card>

      <!-- ============ IMPACT ============ -->
      <Card title="Impact" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-xl bg-gradient-to-br from-sky-950/30 to-slate-950/30 border border-sky-500/20 p-5 text-center">
            <div class="text-3xl font-bold text-sky-300">70%</div>
            <h4 class="font-semibold text-neutral-100 text-sm mt-1">Less manual processing</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed mt-1">
              Automated sync and ETL replaced hours of weekly copy-paste between systems.
            </p>
          </div>
          <div class="rounded-xl bg-gradient-to-br from-sky-950/30 to-slate-950/30 border border-sky-500/20 p-5 text-center">
            <div class="text-3xl font-bold text-sky-300">30%</div>
            <h4 class="font-semibold text-neutral-100 text-sm mt-1">Fewer data errors</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed mt-1">
              Validation and deduplication at intake eliminated the duplicates and inconsistencies of the old system.
            </p>
          </div>
          <div class="rounded-xl bg-gradient-to-br from-sky-950/30 to-slate-950/30 border border-sky-500/20 p-5 text-center">
            <div class="text-3xl font-bold text-sky-300">1</div>
            <h4 class="font-semibold text-neutral-100 text-sm mt-1">Unified warehouse</h4>
            <p class="text-[11px] text-neutral-400 leading-relaxed mt-1">
              Operational and marketing reporting merged into a single source of truth in BigQuery.
            </p>
          </div>
        </div>
      </Card>

      <!-- ============ TECH STACK ============ -->
      <Card title="The stack" rowSpan="lg:row-span-8 md:row-span-6" colSpan="lg:col-span-2">
        <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-sky-300 mb-2 uppercase tracking-wider">Data & warehouse</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Airtable</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">BigQuery</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Python</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">JavaScript</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Zapier</span>
            </div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-sky-300 mb-2 uppercase tracking-wider">Analytics & tracking</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">GA4</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Google Tag Manager</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Search Console</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Looker Studio</span>
            </div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-sky-300 mb-2 uppercase tracking-wider">Paid & growth</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Google Ads</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Meta Ads</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">LinkedIn Ads</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">SEO</span>
            </div>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-4">
            <h4 class="text-xs font-semibold text-sky-300 mb-2 uppercase tracking-wider">Ops & PM</h4>
            <div class="flex flex-wrap gap-1.5">
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Asana</span>
              <span class="rounded-lg bg-white/10 px-2 py-1 text-[11px]">Glide</span>
            </div>
          </div>
        </div>
      </Card>

    </section>
  </main>
</Layout>
