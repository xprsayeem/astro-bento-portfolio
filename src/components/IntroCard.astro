---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS } from "../lib/constants";
import { Icon } from 'astro-icon/components'
import Tooltip from "./Tooltip/index";
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-3">
  <div class="flex w-full h-full gap-4">
    <div class="flex flex-col justify-between flex-1 max-w-[75%]">
      <div class="flex flex-col">
        <h6 class="text-xs font-light m-0 mb-1 text-gray-500">welcome</h6>
        <p class="m-0 font-light text-lg leading-tight">
          Hi, I'm <b class="font-bold">Sayeem Mahfuz.</b> Welcome to my corner of the web — take a look around at what I build and what I'm into.
        </p>
      </div>
      <div class="flex gap-3">
        <a aria-label="github profile" href={LINKS.github} target="_blank">
          <Button aria-label="github profile">
            <Icon class="h-5" name="ri:github-fill" />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a aria-label="linkedin profile" href={LINKS.linkedin} target="_blank">
          <Button aria-label="linkedin profile">
            <Icon class="h-5" name="ri:linkedin-box-fill" />
            <span class="sr-only">Linkedin Profile</span>
          </Button>
        </a>
        <a aria-label="Instagram profile" href={LINKS.instagram} target="_blank">
          <Button aria-label="dribble profile">
            <Icon class="h-5" name="ri:dribbble-fill" />
            <span class="sr-only">Instagram Profile</span>
          </Button>
        </a>
        <Tooltip client:visible>
          <Button aria-label="easter egg btn">
            <Icon class="h-5" name="ri:emotion-laugh-line" />
            <span class="sr-only">Easter egg button</span>
          </Button>
        </Tooltip>
      </div>
    </div>
    <!-- Mobile: faded atmospheric accent bleeding from the right, behind the text -->
    <img
      src="/newpic.jpeg"
      alt=""
      aria-hidden="true"
      class="md:hidden absolute right-[-25%] top-0 h-full w-auto max-w-none object-cover opacity-20 -z-10 pointer-events-none select-none"
      style="object-position: 44% 26%;"
    />

    <!-- md+: framed profile photo with a cool ice-toned gradient frame -->
    <div class="hidden md:flex shrink-0 items-center">
      <div class="rounded-2xl p-[2px] bg-gradient-to-br from-sky-300/70 via-white/25 to-slate-300/55 shadow-xl shadow-black/50">
        <img
          src="/newpic.jpeg"
          alt="Sayeem Mahfuz"
          width="230"
          height="210"
          class="h-[210px] w-[230px] object-cover rounded-[15px] block select-none pointer-events-none"
          style="object-position: 44% 26%;"
        />
      </div>
    </div>
  </div>
</Card>